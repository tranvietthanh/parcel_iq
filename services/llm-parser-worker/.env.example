# =============================================================================
# services/llm-parser-worker — Environment Variables
# Copy to .env and fill in values.
# =============================================================================

# ── Database (psycopg2 — sync driver, Celery workers are sync) ───────────────
DATABASE_URL=postgresql+psycopg2://parceliq:devpassword@localhost:5432/parceliq

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider Configuration ───────────────────────────────────────────────
# Active provider: openai (default), anthropic (Phase 2), or google (Phase 2)
LLM_PROVIDER=openai
LLM_DAILY_QUOTA=100000
LLM_MAX_RPM=60

# ── OpenAI (standard) ───────────────────────────────────────────────────────
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_API_KEY=

# ── Anthropic (Phase 2 placeholders) ─────────────────────────────────────────
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# ── Google AI (Phase 2 placeholders) ─────────────────────────────────────────
# GOOGLE_API_KEY=
# GOOGLE_MODEL=

# ── App Config ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG

