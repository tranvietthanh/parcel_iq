# =============================================================================
# services/llm-parser-worker — Environment Variables
# Copy to .env and fill in values.
# =============================================================================

# ── Database (psycopg2 — sync driver, Celery workers are sync) ───────────────
DATABASE_URL=postgresql+psycopg2://parceliq:devpassword@localhost:5432/parceliq

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── LLM Provider Configuration ───────────────────────────────────────────────
# Active provider: openai (default), anthropic (Phase 2), or google (Phase 2)
LLM_PROVIDER=openai
LLM_DAILY_QUOTA=100000
LLM_MAX_RPM=60

# ── OpenAI (standard) ───────────────────────────────────────────────────────
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-3.5-turbo
OPENAI_API_KEY=

# ── Anthropic ────────────────────────────────────────────────────────────────
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_API_KEY=

# ── Google AI ────────────────────────────────────────────────────────────────
# GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# GOOGLE_MODEL=gemini-1.5-pro
# GOOGLE_API_KEY=

# ── App Config ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=DEBUG

